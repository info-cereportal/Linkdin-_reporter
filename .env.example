# ── デイリー LinkedIn ドラフト生成 設定 ──

# RSS フィード URL（カンマ区切りで複数指定可）
# デフォルト: arXiv Neurons and Cognition
RSS_FEEDS=https://rss.arxiv.org/rss/q-bio.NC

# Webhook URL（Slack Incoming Webhook または Discord Webhook）
# 未設定の場合はコンソール出力のみ
WEBHOOK_URL=

# Webhook タイプ: "slack" or "discord"
WEBHOOK_TYPE=slack

# Discord メンション対象のユーザーID（数字）
DISCORD_MENTION_USER_ID=

# 履歴ファイルパス（トピック重複防止用）
HISTORY_FILE=.daily-history.json

# 履歴保持日数
MAX_HISTORY_DAYS=30
