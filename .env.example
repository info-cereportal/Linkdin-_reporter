# ── デイリー LinkedIn ドラフト生成 設定 ──

# RSS フィード URL（カンマ区切りで複数指定可）
# デフォルト: arXiv Neurons and Cognition
RSS_FEEDS=https://rss.arxiv.org/rss/q-bio.NC

# Webhook URL（Slack Incoming Webhook または Discord Webhook）
# 未設定の場合はコンソール出力のみ
WEBHOOK_URL=

# Webhook タイプ: "slack" or "discord"
WEBHOOK_TYPE=slack

# Discord メンション対象のユーザーID（数字）
DISCORD_MENTION_USER_ID=

# 履歴ファイルパス（トピック重複防止用）
HISTORY_FILE=.daily-history.json

# 履歴保持日数
MAX_HISTORY_DAYS=30

# ─── フィード集約 (5 カテゴリ) ───
# 各カテゴリ毎に RSS URL をカンマ区切りで指定 (未設定はソース内 DEFAULTS)
# FEED_PAPERS_URLS=
# FEED_MARKET_URLS=
# FEED_GRANTS_URLS=
# FEED_AINEURO_URLS=
# FEED_BCI_URLS=
# FEED_MAX_ITEMS=6

# 1論文選定で BCI/ニューラルインターフェース系を優先する重み (0=無効, 1=既定, 2=強)
BIAS_BCI_PICK=1
